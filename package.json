{
  "name": "liquid-monorepo",
  "version": "1.0.0",
  "description": "🫟 Liquid — The ultra-concise frontend framework for the web",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/*",
    "apps/*"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js packages/*/tests/*.test.js packages/*/tests/**/*.test.js",
    "check": "node packages/liquid-cli/bin/liquid.js check",
    "verify:android": "node scripts/verify-android-parity.js",
    "verify:all-templates": "node scripts/verify-all-templates.js",
    "publish:all": "npm publish --workspace=packages/* --access public"
  },
  "devDependencies": {
    "acorn": "^8.19.0",
    "happy-dom": "^17.1.6",
    "puppeteer-core": "^25.17.0"
  }
}
